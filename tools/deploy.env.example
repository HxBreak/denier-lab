# Copy to tools/deploy.env (ignored by git) and fill in. Read by tools/deploy.sh (zsh).
# The ssh command that reaches the web server, as an array; add -J for a jump host, -i for a key.
DEPLOY_SSH=(ssh -i ~/.ssh/<your-key> -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=15
            <user>@<server>)
# The public host name the site is served on; the check fetches the files through it on the server.
DEPLOY_HOST=<your.domain>
